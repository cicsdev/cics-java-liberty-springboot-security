<?xml version="1.0" encoding="UTF-8"?>
<server description="Liberty server for CICS Spring Boot Security sample">

    <featureManager>
        <!-- servlet-6.1 drives Jakarta EE 11 — required for Spring Boot 4.x -->
        <feature>servlet-6.1</feature>
        <!-- CICS security feature — enables CICS identity propagation and SAF authorization -->
        <feature>cicsts:security-1.0</feature>
    </featureManager>

</server>
